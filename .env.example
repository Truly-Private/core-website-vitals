# Core Website Vitals - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ===== SUPABASE CONFIGURATION =====
# Supabase Project URL - Get from your Supabase project dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key - Get from your Supabase project dashboard
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key - Get from your Supabase project dashboard (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== BACKEND CONFIGURATION =====
# JWT Secret Key for token signing (generate a strong secret)
JWT_SECRET_KEY=your-super-secret-jwt-key-here

# Database URL (use Supabase connection string)
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# Redis URL for Celery task queue
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://corewebsitevitals.com

# API Configuration
API_HOST=localhost
API_PORT=8000
API_WORKERS=4

# ===== FRONTEND CONFIGURATION =====
# API Base URL for frontend to connect to backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase configuration for frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== DEVELOPMENT CONFIGURATION =====
# Environment mode
NODE_ENV=development
PYTHON_ENV=development

# Debug settings
DEBUG=true
LOG_LEVEL=info

# ===== CELERY CONFIGURATION =====
# Celery Broker URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_MAX_RETRIES=3

# ===== EXTERNAL SERVICES =====
# Resend Email Service (for transactional emails)
ENABLE_EMAIL_NOTIFICATIONS=true
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@corewebsitevitals.com
EMAIL_FROM_NAME=Core Website Vitals

# OpenAI API Key (for AI features)
OPENAI_API_KEY=your-openai-api-key

# ===== MONITORING & ANALYTICS =====
# Sentry DSN (for error tracking)
SENTRY_DSN=your-sentry-dsn-here

# Google Analytics ID (optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXX

# ===== SECURITY CONFIGURATION =====
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# Session configuration
SESSION_TIMEOUT=3600
REFRESH_TOKEN_EXPIRY=604800

# ===== FEATURE FLAGS =====
# Enable/disable features
ENABLE_REAL_TIME_UPDATES=true
ENABLE_BATCH_ANALYSIS=true
ENABLE_EXPORT_FEATURES=true
ENABLE_NOTIFICATIONS=true

# ===== TESTING CONFIGURATION =====
# Test database URL
TEST_DATABASE_URL=postgresql://postgres:password@localhost:54322/test_db

# Test Redis URL
TEST_REDIS_URL=redis://localhost:6379/1

# ===== DEPLOYMENT CONFIGURATION =====
# Domain configuration
DOMAIN=corewebsitevitals.com
SUBDOMAIN=www

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/domain.crt
SSL_KEY_PATH=/etc/ssl/private/domain.key

# ===== BACKUP CONFIGURATION =====
# Database backup settings
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# ===== PERFORMANCE CONFIGURATION =====
# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_CONNECTIONS=100

# ===== LOCAL DEVELOPMENT =====
# Local Supabase instance (when using supabase start)
LOCAL_SUPABASE_URL=http://localhost:54321
LOCAL_SUPABASE_ANON_KEY=local-anon-key
LOCAL_SUPABASE_SERVICE_ROLE_KEY=local-service-role-key

# Local database connection
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres