# Backend Environment Variables

# Application
APP_NAME="Core Website Vitals"
APP_VERSION="1.0.0"
DEBUG=True
TESTING=False

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_RELOAD=True

# Frontend
FRONTEND_URL="http://localhost:3000"
FRONTEND_DOMAIN="localhost:3000"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
CORS_ALLOW_CREDENTIALS=True

# Supabase Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Configuration
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""

# Celery Configuration
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_WORKER_CONCURRENCY=4
CELERY_MAX_RETRIES=3

# Email Configuration (Resend)
ENABLE_EMAIL_NOTIFICATIONS=True
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM_ADDRESS="noreply@corewebsitevitals.com"
EMAIL_FROM_NAME="Core Website Vitals"

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALLOWED_HOSTS="localhost,127.0.0.1"

# Feature Flags
ENABLE_REAL_TIME_UPDATES=True

# External Services (Optional)
SENTRY_DSN=""
ANALYTICS_API_KEY=""

# SEO Analysis Configuration
SEO_ANALYSIS_TIMEOUT=300
SEO_ANALYSIS_MAX_CONCURRENT=10
SEO_ANALYSIS_RATE_LIMIT=100

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# Timezone
TIMEZONE="UTC"